{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adheform.ai/contracts/events/events.schema.json",
  "title": "事件 payload 定义（§16.4）",
  "description": "每个 $def 对应信封 data 字段的一个事件类型；type 名与 catalog.json 事件目录一致。所有事件经信封校验（../schemas/envelope.schema.json）。事件 schema 升版本时消费者需兼容至少两个版本（§16.4）。",
  "$defs": {
    "FormulaImported": {
      "type": "object",
      "required": ["import_batch_id", "row_count", "blocked_count"],
      "additionalProperties": false,
      "properties": {
        "import_batch_id": { "type": "string" },
        "row_count": { "type": "integer", "minimum": 0, "description": "总行数。" },
        "blocked_count": { "type": "integer", "minimum": 0, "description": "阻断级 QC 拒收行数（§3.3）；明细进审计。" }
      }
    },
    "FormulaVersionCreated": {
      "type": "object",
      "required": ["formula_id", "formula_version_id", "version"],
      "additionalProperties": false,
      "properties": {
        "formula_id": { "type": "string" },
        "formula_version_id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "ExperimentCompleted": {
      "type": "object",
      "required": ["experiment_id", "formula_version_id", "completed_at"],
      "additionalProperties": false,
      "properties": {
        "experiment_id": { "type": "string" },
        "formula_version_id": { "type": "string" },
        "completed_at": { "$ref": "../schemas/common.schema.json#/$defs/Iso8601" },
        "has_results": { "type": "boolean", "description": "false = 空转/失败完成，QC 侧按负结果留档处理。" }
      }
    },
    "DataAccepted": {
      "type": "object",
      "required": ["experiment_id", "formula_version_id", "dataset_snapshot_id"],
      "additionalProperties": false,
      "properties": {
        "experiment_id": { "type": "string" },
        "formula_version_id": { "type": "string" },
        "dataset_snapshot_id": { "$ref": "../schemas/common.schema.json#/$defs/DatasetSnapshotId" },
        "fidelity": { "type": "string", "enum": ["experiment", "literature", "simulation"], "description": "多保真度标记（§3.4）；literature/simulation 仅作弱先验。" }
      }
    },
    "DataRejected": {
      "type": "object",
      "required": ["experiment_id", "reason_codes"],
      "additionalProperties": false,
      "properties": {
        "experiment_id": { "type": "string" },
        "reason_codes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "QC 拒收原因码（§3.3 规则 ID）。" }
      }
    },
    "DatasetSnapshotFrozen": {
      "type": "object",
      "required": ["dataset_snapshot_id", "content_hash", "train_row_count"],
      "additionalProperties": false,
      "properties": {
        "dataset_snapshot_id": { "$ref": "../schemas/common.schema.json#/$defs/DatasetSnapshotId" },
        "content_hash": { "type": "string", "minLength": 32, "maxLength": 128, "examples": ["sha256:9f2c1a7b3e5d0f8a2c4e6b8d0a1f3c5e7b9d1a3c5e7f8a2b4d6e8f0a1c3e5b7d"], "description": "快照内容哈希（冻结即写，§16.5 强一致）。" },
        "train_row_count": { "type": "integer", "minimum": 0 }
      }
    },
    "RecommendationIssued": {
      "description": "active-learning-svc 发布；experiment-svc / audit 消费。R2.2 skeleton 已使用，本目录补录。",
      "type": "object",
      "required": ["recommendation_batch_id", "candidates", "strategy", "model_version"],
      "additionalProperties": false,
      "properties": {
        "recommendation_batch_id": { "type": "string" },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["candidate_id", "x", "expected_gain"],
            "additionalProperties": false,
            "properties": {
              "candidate_id": { "type": "string" },
              "x": { "$ref": "../schemas/common.schema.json#/$defs/FeatureVector" },
              "expected_gain": { "type": "number", "description": "采集函数增益（EI/UCB 等）。" }
            }
          }
        },
        "strategy": { "type": "string", "description": "推荐策略标识（active_ucb / active_ei / doe ...）。" },
        "model_version": { "$ref": "../schemas/common.schema.json#/$defs/ModelVersion" }
      }
    },
    "ModelTrained": {
      "type": "object",
      "required": ["model_version", "model_version_of", "dataset_snapshot_id", "feature_set_version", "metrics"],
      "additionalProperties": false,
      "properties": {
        "model_version": { "$ref": "../schemas/common.schema.json#/$defs/ModelVersion" },
        "model_version_of": { "type": "string", "description": "逻辑模型名（如 adhe-tg-regressor）。" },
        "dataset_snapshot_id": { "$ref": "../schemas/common.schema.json#/$defs/DatasetSnapshotId" },
        "feature_set_version": { "$ref": "../schemas/common.schema.json#/$defs/FeatureSetVersion" },
        "metrics": {
          "type": "object",
          "description": "评估指标（RMSE/MAE/覆盖率/违规率，§5.5 门禁输入）。键为指标名。"
        }
      }
    },
    "ModelPromoted": {
      "type": "object",
      "required": ["model_version", "model_version_of", "gate_result"],
      "additionalProperties": false,
      "properties": {
        "model_version": { "$ref": "../schemas/common.schema.json#/$defs/ModelVersion" },
        "model_version_of": { "type": "string" },
        "gate_result": {
          "type": "object",
          "required": ["passed", "checked_rules"],
          "additionalProperties": false,
          "properties": {
            "passed": { "type": "boolean" },
            "checked_rules": { "type": "array", "items": { "type": "string" }, "description": "门禁规则 ID 清单（§5.5）。" }
          }
        },
        "shadow": { "type": "boolean", "description": "true = 影子流量观察期开始（§17.3）。" }
      }
    },
    "CanaryFailed": {
      "type": "object",
      "required": ["model_version", "reason", "rollback_to"],
      "additionalProperties": false,
      "properties": {
        "model_version": { "$ref": "../schemas/common.schema.json#/$defs/ModelVersion" },
        "reason": { "type": "string", "description": "金丝雀失败原因（语义断言 / 金丝雀配方集回归 / 延迟超限）。" },
        "rollback_to": { "$ref": "../schemas/common.schema.json#/$defs/ModelVersion", "description": "回滚目标版本；生产版本指针切换为强一致（§16.5）。" }
      }
    },
    "DriftDetected": {
      "type": "object",
      "required": ["model_version", "drift_type", "severity"],
      "additionalProperties": false,
      "properties": {
        "model_version": { "$ref": "../schemas/common.schema.json#/$defs/ModelVersion" },
        "drift_type": { "type": "string", "enum": ["feature", "prediction", "performance"], "description": "特征漂移 / 预测分布漂移 / 线上表现漂移。" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "detail_ref": { "type": "string", "description": "漂移报告对象存储键。" }
      }
    },
    "ExportRequested": {
      "type": "object",
      "required": ["export_request_id", "requested_by", "scope", "classification"],
      "additionalProperties": false,
      "properties": {
        "export_request_id": { "type": "string" },
        "requested_by": { "type": "string", "description": "用户标识，不落 PII 明文（§8.3）。" },
        "scope": { "type": "string", "description": "导出范围描述（配方集 / 快照 / 报表）。" },
        "classification": { "type": "string", "enum": ["L0", "L1", "L2", "L3"], "description": "所涉最高密级（§8.1）。L3 导出强制审批 + 水印。" }
      }
    }
  }
}
