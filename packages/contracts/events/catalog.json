      "publisher": "data-hub-svc",
      "consumers": [
        "prediction-svc",
        "model-lifecycle-svc",
        "auth-audit-svc"
      ],
      "delivery": "at-least-once-idempotent",
      "payload_ref": "events.schema.json#/$defs/FormulaImported",
      "architecture_ref": "ARCHITECTURE.md §16.4"
    },
